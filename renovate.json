{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "automerge": true,
  "automergeType": "pr",
  "rebaseWhen": "conflicted",
  "schedule": ["* 10-23 * * 2,4,6"],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 10-23 * * 6"]
  },
  "packageRules": [
    {
      "description": "Group non-major updates into one PR; later rules that set groupName split off",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Major updates are merged by hand",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Treat minor updates of 0.x versions as breaking",
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "groupName": "0.x minor updates"
    },
    {
      "description": "Update Node.js in mise.toml and elsewhere together, LTS (even) majors only",
      "groupName": "node",
      "matchDepNames": ["node"],
      "allowedVersions": "/^v?\\d*[02468]\\./"
    },
    {
      "description": "Update pnpm in mise.toml and packageManager together",
      "groupName": "pnpm",
      "matchDepNames": ["pnpm"]
    },
    {
      "description": "Tauri's Rust crates and JS packages must move together",
      "groupName": "tauri",
      "matchPackageNames": ["tauri", "tauri-build", "tauri-plugin-*", "@tauri-apps/*"]
    },
    {
      "description": "tauri-specta release candidates are pinned exactly and move together",
      "groupName": "specta",
      "matchPackageNames": ["specta", "specta-typescript", "tauri-specta"]
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxlint-tsgolint", "oxfmt"]
    },
    {
      "groupName": "test tooling",
      "matchPackageNames": [
        "vitest",
        "@vitest/*",
        "@playwright/test",
        "@testing-library/*",
        "happy-dom"
      ]
    }
  ]
}
